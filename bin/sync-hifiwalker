#!/bin/bash

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

MUSIC_DIR="$HOME/Music"
MOUNT_LABEL="H2"
MOUNT_POINT="/run/media/$USER/$MOUNT_LABEL"
DRY_RUN=false

print_status()  { echo -e "${BLUE}[INFO]${NC} $1"; }
print_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
print_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
print_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

usage() {
    echo "Usage: $(basename "$0") [-n|--dry-run]"
    echo ""
    echo "Syncs ~/Music to the HIFI Walker H2 (mounted at $MOUNT_POINT)."
    echo "Only albums referenced by playlists in ~/Music are synced."
    echo ""
    echo "Options:"
    echo "  -n, --dry-run   Show what would be transferred without copying"
    exit 0
}

check_device() {
    if [[ ! -d "$MOUNT_POINT" ]]; then
        print_error "HIFI Walker not found at $MOUNT_POINT"
        print_error "Connect the device and ensure it is mounted before running this script."
        exit 1
    fi
}

# Emit rsync filter args based on albums referenced in playlists.
# Includes playlist files, then each referenced artist/ and artist/album/***.
# Excludes everything else.
build_filter() {
    echo "--include=*.m3u"

    grep -rh "^[^#]" "$MUSIC_DIR"/*.m3u \
        | sed 's|/[^/]*$||' \
        | awk -F'/' 'NF >= 3 { print $1"/"$2 } NF < 3 { print }' \
        | sort -u \
        | while IFS= read -r album; do
            echo "--include=${album%%/*}/"
            echo "--include=${album}/***"
        done

    echo "--exclude=*"
}

check_space() {
    print_status "Calculating transfer size..."

    local -a filter_opts
    while IFS= read -r opt; do
        filter_opts+=("$opt")
    done < <(build_filter)

    local transfer_bytes
    transfer_bytes=$(rsync -an --stats "${filter_opts[@]}" "$MUSIC_DIR/" "$MOUNT_POINT/" \
        | grep "Total transferred file size" \
        | awk '{print $5}' | tr -d ',')

    local available_bytes
    available_bytes=$(df -k "$MOUNT_POINT" | awk 'NR==2 {print $4}')
    available_bytes=$((available_bytes * 1024))

    local transfer_human
    transfer_human=$(numfmt --to=iec "$transfer_bytes" 2>/dev/null || echo "${transfer_bytes} bytes")
    local available_human
    available_human=$(numfmt --to=iec "$available_bytes" 2>/dev/null || echo "${available_bytes} bytes")

    print_status "To transfer: $transfer_human"
    print_status "Available:   $available_human"

    if (( transfer_bytes > available_bytes )); then
        print_error "Not enough space on device ($transfer_human needed, $available_human free)."
        exit 1
    fi
}

sync_music() {
    local -a filter_opts
    while IFS= read -r opt; do
        filter_opts+=("$opt")
    done < <(build_filter)

    local rsync_opts=(-avh --progress "${filter_opts[@]}")
    if $DRY_RUN; then
        rsync_opts+=(-n)
        print_status "Dry run — no files will be copied."
    fi

    print_status "Syncing $MUSIC_DIR → $MOUNT_POINT ..."
    rsync "${rsync_opts[@]}" "$MUSIC_DIR/" "$MOUNT_POINT/"

    if ! $DRY_RUN; then
        print_success "Sync complete."
        sync
        print_status "Buffers flushed. Safe to unplug."
    fi
}

for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) DRY_RUN=true ;;
        -h|--help)    usage ;;
        *) print_error "Unknown option: $arg"; usage ;;
    esac
done

check_device
check_space
sync_music
