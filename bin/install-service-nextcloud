#!/bin/bash
# Install and start the Nextcloud sync client.
#
# This is deliberately NOT part of the setup scripts. A sync client is useless
# until it has been pointed at a server and authenticated in a browser, so
# installing it unattended during a rebuild just leaves an unconfigured client
# sitting in the tray. On Arch it is also one of the slower AUR builds, which is
# a poor thing to put between a fresh machine and a usable desktop.
#
# Run it once, by hand, after the desktop is up.
#
# Uninstall with:
#     yay -Rns nextcloud-client      # Arch
#     brew uninstall --cask nextcloud # macOS

set -euo pipefail

case "$(uname -s)" in
    Linux)
        command -v yay &>/dev/null || { echo "yay is required; run setup/arch.sh first" >&2; exit 1; }
        echo "Installing nextcloud-client..."
        yay -S --needed --noconfirm --answerdiff None --answerclean None nextcloud-client

        # Start in a transient systemd scope so the client gets its own cgroup
        # rather than being a stray child of this shell, and dies with the
        # session instead of being reparented to init. The session is launched
        # by start-hyprland, not uwsm (see docs/hyprland-startup.md), so uwsm-app
        # is not the right tool here even where uwsm happens to be installed.
        if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
            echo "Starting Nextcloud..."
            systemd-run --user --scope --quiet nextcloud --background &>/dev/null &
        else
            echo "No Wayland session detected; start it from your session with:"
            echo "    nextcloud --background"
        fi
        ;;
    Darwin)
        command -v brew &>/dev/null || { echo "Homebrew is required; run setup/macos.sh first" >&2; exit 1; }
        echo "Installing nextcloud..."
        brew install --cask nextcloud
        open -a Nextcloud || true
        ;;
    *)
        echo "Unsupported platform: $(uname -s)" >&2
        exit 1
        ;;
esac

cat <<'EOF'

Nextcloud installed.

Next steps, both done inside the client:
  1. Connect to your server and authenticate in the browser it opens.
  2. On Linux nothing further is needed for persistence: Hyprland's
     config/hypr/conf/autostart.lua launches the client on session start once
     it is installed. Plain Hyprland does not process ~/.config/autostart, so
     the client's own "Launch on system startup" setting has no effect here.

On Linux the sync status icon appears in waybar's tray module.
EOF
