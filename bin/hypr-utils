#!/bin/sh
# Shared display helpers — source this file, do not execute directly.

log_display() {
    state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
    mkdir -p "$state_dir"
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$state_dir/hypr-display.log"
}

get_internal_mon() {
    hyprctl monitors all -j | jq -r '.[] | select(.name | test("^eDP")).name' | head -n 1
}

get_primary_external_mon() {
    # Use "monitors all" and do not filter out disabled outputs: after boot or
    # hotplug Hyprland may know about the external display while it is still
    # disabled. Selecting it here lets apply_monitor turn it on before eDP is
    # disabled for clamshell mode.
    hyprctl monitors all -j | jq -r '.[] | select(.name | test("^eDP") | not).name' | head -n 1
}

has_external_monitors() {
    for status in /sys/class/drm/card*-*/status; do
        case "$status" in *eDP*) continue ;; esac
        [ "$(cat "$status")" = "connected" ] && return 0
    done
    return 1
}

is_lid_closed() {
    for lid_path in \
        /proc/acpi/button/lid/LID/state \
        /proc/acpi/button/lid/LID0/state \
        /proc/acpi/button/lid/LID1/state; do
        [ -r "$lid_path" ] || continue
        case "$(cat "$lid_path")" in
            *closed*) return 0 ;;
            *) return 1 ;;
        esac
    done
    return 1
}

# Apply a monitor spec through the Lua config parser.
#
# Hyprland 0.55+ refuses `hyprctl keyword` when the config is Lua ("keyword
# can't work with non-legacy parsers. Use eval.") and still exits 0 while doing
# so, so every call here silently did nothing after the Lua migration. Always
# check the result: `hyprctl eval` does exit non-zero on error, but a rejected
# keyword-style failure would not, so the output is checked too.
#
# "ok" is not proof of anything either: `disabled` is sticky, so a spec that
# omits it leaves a disabled output disabled and still reports success. Every
# caller therefore states `disabled` explicitly and the result is verified
# against `hyprctl monitors all` before returning.
#
# Usage: apply_monitor <description> <output> <want-disabled true|false> <extra lua fields>
apply_monitor() {
    apply_what=$1
    apply_out_name=$2
    apply_want=$3
    apply_extra=$4

    log_display "$apply_what"
    apply_spec="output = \"$apply_out_name\", disabled = $apply_want"
    [ -n "$apply_extra" ] && apply_spec="$apply_spec, $apply_extra"

    apply_res=$(hyprctl eval "hl.monitor({ $apply_spec })" 2>&1)
    apply_rc=$?

    if [ "$apply_rc" -ne 0 ] || [ "$apply_res" != "ok" ]; then
        log_display "ERROR: $apply_what failed (rc=$apply_rc): ${apply_res:-no output}"
        return 1
    fi

    apply_now=$(hyprctl monitors all -j |
        jq -r --arg m "$apply_out_name" '.[] | select(.name == $m).disabled')
    if [ "$apply_now" != "$apply_want" ]; then
        log_display "ERROR: $apply_what reported ok but disabled=$apply_now (wanted $apply_want)"
        return 1
    fi
    return 0
}

place_primary_external_auto() {
    external_mon=$(get_primary_external_mon)
    [ -n "$external_mon" ] || return 1

    apply_monitor "enabling/placing external monitor automatically: $external_mon" \
        "$external_mon" false \
        "mode = \"preferred\", position = \"auto\", scale = \"auto\""
}

disable_internal() {
    internal_mon=$(get_internal_mon)
    [ -n "$internal_mon" ] || return 0

    apply_monitor "disabling internal monitor: $internal_mon" \
        "$internal_mon" true "" || return 1

    if has_external_monitors; then
        place_primary_external_auto || true
    fi
}

enable_internal() {
    internal_mon=$(get_internal_mon)
    [ -n "$internal_mon" ] || return 0

    apply_monitor "enabling internal monitor automatically: $internal_mon" \
        "$internal_mon" false \
        "mode = \"preferred\", position = \"auto\", scale = 1.5" || return 1
    hyprctl dispatch dpms on "$internal_mon" >/dev/null

    if has_external_monitors; then
        place_primary_external_auto || true
    fi
}

restart_waybar() {
    log_display "restarting waybar after monitor change"
    pkill -x waybar 2>/dev/null || true
    sleep 0.5
    nohup waybar >/dev/null 2>&1 &
}
