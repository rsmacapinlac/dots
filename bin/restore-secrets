#!/bin/bash
#
# Restore SSH keys, GPG keys, and the password store.
#
# This is the second half of a rebuild. `setup/arch.sh` builds the machine and
# needs no secrets; everything that requires private key material lives here so
# the build can run unattended, in a VM, or before the key backup is at hand.
#
# Usage:
#   cd /path/to/key-backup && restore-secrets
#   restore-secrets --source /run/media/$USER/DATA/newcomputer
#
# The source directory must contain:
#   ssh/    private and public keys, copied to ~/.ssh
#   gpg/    public.pgp and private.pgp, imported and trusted
#
# Every step is idempotent and skips work that is already done, so this is safe
# to rerun.

set -euo pipefail

SOURCE_DIR="."
PASS_REPO="git@github.com:rsmacapinlac/cautious-dollop.git"
DO_SSH=true
DO_GPG=true
DO_PASS=true

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info()    { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error()   { echo -e "${RED}[ERROR]${NC} $1"; }

usage() {
    sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

parse_args() {
    while (( $# > 0 )); do
        case "$1" in
            --source)    SOURCE_DIR="${2:?--source requires a directory}"; shift 2 ;;
            --skip-ssh)  DO_SSH=false;  shift ;;
            --skip-gpg)  DO_GPG=false;  shift ;;
            --skip-pass) DO_PASS=false; shift ;;
            -h|--help)   usage 0 ;;
            *)           log_error "Unknown option: $1"; usage 1 ;;
        esac
    done
}

check_not_root() {
    if [[ $EUID -eq 0 ]]; then
        log_error "Run this as your normal user, not root."
        exit 1
    fi
}

# Copy SSH keys into place with correct permissions.
#
# The key backup usually lives on a vfat drive, which reports every file as
# mode 755. ssh(1) refuses to use a private key that is group- or
# world-readable, so permissions are set explicitly here rather than inherited
# from the copy. All private keys are fixed, not just id_rsa.
restore_ssh() {
    if [[ $DO_SSH != true ]]; then
        log_info "Skipping SSH restore (--skip-ssh)"
        return 0
    fi

    if [[ -f $HOME/.ssh/id_rsa ]]; then
        log_info "SSH key already present at ~/.ssh/id_rsa, skipping"
        return 0
    fi

    local src="$SOURCE_DIR/ssh"
    if [[ ! -d $src ]]; then
        log_error "SSH key folder not found: $src"
        log_error "Pass --source <dir>, or run from the directory holding ssh/ and gpg/."
        return 1
    fi

    log_info "Restoring SSH keys from $src..."
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"

    # Skip macOS resource-fork files (._*) that vfat backups collect.
    local f base
    for f in "$src"/*; do
        base="$(basename "$f")"
        [[ -f $f ]] || continue
        [[ $base == ._* ]] && continue
        cp -f "$f" "$HOME/.ssh/$base"
    done

    for f in "$HOME"/.ssh/*; do
        [[ -f $f ]] || continue
        case "$f" in
            # Public and non-key files: readable, never executable.
            *.pub|*/known_hosts|*/known_hosts.old|*/authorized_keys|*/config)
                chmod 644 "$f" ;;
            # Everything else is treated as a private key.
            *)  chmod 600 "$f" ;;
        esac
    done

    log_success "SSH keys restored to ~/.ssh"
}

# Import and ultimately-trust the GPG keys. `pass` cannot decrypt without this.
restore_gpg() {
    if [[ $DO_GPG != true ]]; then
        log_info "Skipping GPG restore (--skip-gpg)"
        return 0
    fi

    if gpg --list-secret-keys 2>/dev/null | grep -q "sec"; then
        log_info "GPG secret key already in the keyring, skipping"
        return 0
    fi

    local src="$SOURCE_DIR/gpg"
    if [[ ! -d $src ]]; then
        log_error "GPG key folder not found: $src"
        log_error "Pass --source <dir>, or run from the directory holding ssh/ and gpg/."
        return 1
    fi

    if [[ ! -f $src/private.pgp ]]; then
        log_error "Expected $src/private.pgp"
        return 1
    fi

    log_info "Importing GPG keys from $src..."
    mkdir -p "$HOME/.gnupg"
    chmod 700 "$HOME/.gnupg"

    [[ -f $src/public.pgp ]] && gpg --batch --import "$src/public.pgp"
    gpg --batch --pinentry-mode loopback --import "$src/private.pgp"

    # Set ultimate trust on every imported secret key.
    #
    # Uses --import-ownertrust rather than piping "5\ny" into `--edit-key trust`.
    # The interactive form silently fails to record the trust value under
    # --command-fd, leaving pass unable to encrypt to the key. The ownertrust
    # format is FINGERPRINT:LEVEL: where 6 = ultimate.
    #
    # Only primary-key fingerprints are wanted, so take the first fpr line
    # following each sec line and ignore subkey fingerprints.
    local fpr
    while read -r fpr; do
        [[ -n $fpr ]] || continue
        if echo "${fpr}:6:" | gpg --import-ownertrust &>/dev/null; then
            log_info "  ultimate trust set on ${fpr: -16}"
        else
            log_warning "Could not set trust on ${fpr: -16}"
        fi
    done < <(gpg --list-secret-keys --with-colons | awk -F: '/^sec:/ {want=1; next} /^fpr:/ && want {print $10; want=0}')

    log_success "GPG keys imported and trusted"
}

# Clone the password store. This is the one genuinely SSH-dependent step: the
# repository is private, so there is no credential-free path to it.
restore_pass_store() {
    if [[ $DO_PASS != true ]]; then
        log_info "Skipping password store (--skip-pass)"
        return 0
    fi

    if [[ -d $HOME/.password-store ]]; then
        log_info "Password store already exists, skipping clone"
        return 0
    fi

    if [[ ! -f $HOME/.ssh/id_rsa ]]; then
        log_error "No SSH key at ~/.ssh/id_rsa; cannot clone the private password store."
        return 1
    fi

    # Use the running agent if there is one, otherwise start a throwaway agent
    # for the duration of this script. A `ssh-agent` started here cannot outlive
    # the process, so the user's shell gets its own via ssh-agent.service.
    local started_agent=false
    if [[ -z ${SSH_AUTH_SOCK:-} ]]; then
        eval "$(ssh-agent -s)" >/dev/null
        started_agent=true
    fi
    ssh-add "$HOME/.ssh/id_rsa" 2>/dev/null || log_warning "ssh-add failed; the clone may prompt for a passphrase"

    log_info "Cloning password store..."
    if git clone "$PASS_REPO" "$HOME/.password-store"; then
        log_success "Password store cloned"
    else
        log_error "Failed to clone the password store from $PASS_REPO"
        [[ $started_agent == true ]] && ssh-agent -k >/dev/null 2>&1 || true
        return 1
    fi

    [[ $started_agent == true ]] && ssh-agent -k >/dev/null 2>&1 || true
    return 0
}

verify() {
    log_info "Verifying..."
    local ok=true

    [[ -f $HOME/.ssh/id_rsa ]] \
        && log_success "  ssh: ~/.ssh/id_rsa present ($(stat -c '%a' "$HOME/.ssh/id_rsa"))" \
        || { log_warning "  ssh: no ~/.ssh/id_rsa"; ok=false; }

    gpg --list-secret-keys 2>/dev/null | grep -q "sec" \
        && log_success "  gpg: secret key in keyring" \
        || { log_warning "  gpg: no secret key"; ok=false; }

    [[ -d $HOME/.password-store ]] \
        && log_success "  pass: ~/.password-store present" \
        || { log_warning "  pass: no password store"; ok=false; }

    if [[ $ok == true ]]; then
        log_success "Secrets restored. Mail and pass-backed tools should now work."
    else
        log_warning "Some steps did not complete; see above."
        return 1
    fi
}

main() {
    parse_args "$@"
    check_not_root

    SOURCE_DIR="${SOURCE_DIR%/}"
    log_info "Restoring secrets (source: $(cd "$SOURCE_DIR" 2>/dev/null && pwd || echo "$SOURCE_DIR"))"

    restore_ssh
    restore_gpg
    restore_pass_store
    verify
}

main "$@"
