# Override of /usr/share/applications/com.anthropic.Claude.desktop.
#
# claude-desktop is a bare Electron binary (/usr/bin/claude-desktop is a symlink
# into /usr/lib/claude-desktop) with no launcher wrapper, so it has no
# flags.conf to read. The only way to pin its os_crypt backend is on the command
# line, which means overriding the Exec lines here. Without this it falls back
# to the plaintext basic_text store and reports
# safeStorage isEncryptionAvailable=false, so logins never persist.
#
# Copied verbatim from the packaged entry apart from --password-store. If the
# claude-desktop package changes its Exec lines or Actions, re-sync this file.
[Desktop Entry]
Name=Claude
Comment=Desktop application for Claude.ai
GenericName=AI Assistant
Keywords=AI;Chat;Assistant;Claude;Code;LLM;
Exec=claude-desktop --password-store=gnome-libsecret %U
Icon=claude-desktop
Type=Application
StartupNotify=true
# Matches the Wayland app_id / X11 WM_CLASS Chromium derives from
# package.json desktopName, so docks group windows under this entry.
StartupWMClass=com.anthropic.Claude
# second-instance just focuses mainWindow; suppress GNOME's default "New Window" item
SingleMainWindow=true
Categories=Utility;Development;
MimeType=x-scheme-handler/claude;
Actions=NewChat;NewCode;

[Desktop Action NewChat]
Name=New Chat
Exec=claude-desktop --password-store=gnome-libsecret "claude://claude.ai/new?surface=chat&source=desktop_action"

[Desktop Action NewCode]
Name=New Claude Code Session
Exec=claude-desktop --password-store=gnome-libsecret "claude://code/new?source=desktop_action"
