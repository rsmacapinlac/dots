# A single tree: this repository, standalone and self-sufficient.
#
# If you keep personal configuration in a private companion repository, that
# repository ships its own rcrc listing both trees, itself first, so its files
# override these defaults. rcm deploys the first tree that provides a path.
# Bootstrap it once with:
#
#   env RCRC="$HOME/workspace/<private-repo>/rcrc" rcup
#
# after which ~/.rcrc resolves from there and plain `rcup` keeps working.
DOTFILES_DIRS="$HOME/workspace/dots"
