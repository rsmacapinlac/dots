#!/bin/bash
#
# Generate the per-application colour palettes from a single source.
#
# The same Catppuccin palette has to exist in three syntaxes, because each
# consumer parses a different language and none of them can read the others:
#
#   config/hypr/conf/colors.lua           Hyprland (Lua config)
#   config/hypr/colors.conf               hyprlock (hyprlang; Hyprland itself moved to Lua)
#   config/quickshell/Commons/Colors.qml  Quickshell (QML singleton)
#
# All three outputs are named for what they hold, not for the flavour that
# filled them, so switching flavours is editing config/theme/<flavor>.json and
# regenerating -- never renaming files and chasing down every reference.
#
# Hand-maintaining three copies means they drift, and a drifted palette is
# invisible until something renders in the wrong colour. This script makes
# config/theme/<flavor>.json authoritative and rewrites all three outputs from
# it. Run it after editing the source, then commit the generated files: rcm
# deploys from the checkout, and Hyprland reads colors.lua at session start.
#
# Safe to rerun; output is deterministic, so an unchanged source produces no
# diff.

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
FLAVOR="${1:-mocha}"
SOURCE="$REPO_ROOT/config/theme/$FLAVOR.json"

LUA_OUT="$REPO_ROOT/config/hypr/conf/colors.lua"
CONF_OUT="$REPO_ROOT/config/hypr/colors.conf"
# Not "Palette": QtQuick already defines a Palette type, and it silently wins
# the name lookup, leaving every colour undefined rather than raising an error.
QML_OUT="$REPO_ROOT/config/quickshell/Commons/Colors.qml"

command -v jq >/dev/null 2>&1 || { log_error "jq is required"; exit 1; }
[[ -f $SOURCE ]] || { log_error "No palette source at $SOURCE"; exit 1; }

# Names in source order. jq's keys_unsorted preserves the JSON ordering, which
# is what keeps the generated files diff-stable against the hand-written
# originals rather than reshuffling them alphabetically.
mapfile -t NAMES < <(jq -r '.colors | keys_unsorted[]' "$SOURCE")
(( ${#NAMES[@]} > 0 )) || { log_error "$SOURCE defines no colors"; exit 1; }

hex_for() {
    jq -r --arg k "$1" '.colors[$k]' "$SOURCE"
}

# Every consumer writes bare hex without the leading '#', so reject anything
# that is not exactly six hex digits rather than emitting a file that parses
# but renders wrong.
for name in "${NAMES[@]}"; do
    hex="$(hex_for "$name")"
    [[ $hex =~ ^[0-9a-fA-F]{6}$ ]] || {
        log_error "Color '$name' is '$hex'; expected six hex digits without '#'"
        exit 1
    }
done

DISPLAY_NAME="$(jq -r '.name // "Unknown"' "$SOURCE")"
IS_DARK="$(jq -r 'if .dark == false then "false" else "true" end' "$SOURCE")"

# Width of the longest name, so the Lua table's '=' column lines up the way the
# hand-written file did.
pad=0
for name in "${NAMES[@]}"; do
    (( ${#name} > pad )) && pad=${#name}
done

generate_lua() {
    {
        printf -- '-- %s palette for the Hyprland Lua config.\n' "$DISPLAY_NAME"
        printf -- '--\n'
        printf -- '-- Generated by maintenance/generate-theme from config/theme/%s.json.\n' "$FLAVOR"
        printf -- '-- Do not edit by hand; edit the source and regenerate.\n'
        printf -- '\n'
        printf 'return {\n'
        for name in "${NAMES[@]}"; do
            printf '    %-*s = "rgb(%s)",\n' "$pad" "$name" "$(hex_for "$name")"
        done
        printf '}\n'
    } > "$LUA_OUT"
}

generate_conf() {
    {
        printf '# %s palette in hyprlang form, sourced by hyprlock.\n' "$DISPLAY_NAME"
        printf '#\n'
        printf '# Generated by maintenance/generate-theme from config/theme/%s.json.\n' "$FLAVOR"
        printf '# Do not edit by hand; edit the source and regenerate.\n'
        for name in "${NAMES[@]}"; do
            hex="$(hex_for "$name")"
            printf '\n$%s = rgb(%s)\n$%sAlpha = %s\n' "$name" "$hex" "$name" "$hex"
        done
    } > "$CONF_OUT"
}

generate_qml() {
    mkdir -p "$(dirname "$QML_OUT")"
    {
        printf '// %s palette as a Quickshell singleton.\n' "$DISPLAY_NAME"
        printf '//\n'
        printf '// Generated by maintenance/generate-theme from config/theme/%s.json.\n' "$FLAVOR"
        printf '// Do not edit by hand; edit the source and regenerate.\n'
        printf '//\n'
        printf '// These are raw palette colours. Widgets bind to Theme, not to this\n'
        printf '// file, so that swapping the palette never touches widget code.\n'
        printf '\n'
        printf 'pragma Singleton\n'
        printf 'import QtQuick\n'
        printf '\n'
        printf 'QtObject {\n'
        printf '    readonly property string name: "%s"\n' "$DISPLAY_NAME"
        printf '    readonly property bool dark: %s\n' "$IS_DARK"
        printf '\n'
        for name in "${NAMES[@]}"; do
            printf '    readonly property color %-*s "#%s"\n' "$((pad + 1))" "$name:" "$(hex_for "$name")"
        done
        printf '}\n'
    } > "$QML_OUT"
}

log_info "Generating $DISPLAY_NAME palettes from config/theme/$FLAVOR.json"
generate_lua
generate_conf
generate_qml
log_success "Wrote ${LUA_OUT#"$REPO_ROOT"/}"
log_success "Wrote ${CONF_OUT#"$REPO_ROOT"/}"
log_success "Wrote ${QML_OUT#"$REPO_ROOT"/}"
